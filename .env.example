# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tourchef

# Backend (Go / Fiber)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tourchef?sslmode=disable
JWT_SECRET=dev-only-secret-change-me-in-production
PORT=8080
SEED=true
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads

# Frontend (Nuxt 3)
# Frontend: /api orqali murojaat qiladi, Nitro backendga proxy qiladi
NUXT_PUBLIC_API_BASE=/api
API_PROXY_TARGET=http://localhost:8080
