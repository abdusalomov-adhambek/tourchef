# VPS: copy to /opt/tourchef/.env and fill with real secrets (never commit it).
# Use URL-safe values (e.g. `openssl rand -hex 24`) — the DB password is
# interpolated into DATABASE_URL.
POSTGRES_USER=tourchef
POSTGRES_PASSWORD=replace-with-hex
POSTGRES_DB=tourchef

JWT_SECRET=replace-with-long-hex
JWT_EXPIRY=168h

# true only for the first deployment; set to false after changing demo passwords
SEED=true

SITE_URL=https://tourchef.app.codeops.uz
